{
  "$defs": {
    "BackgroundAnchor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "image_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "class_id": {
          "const": 0,
          "title": "Class Id",
          "type": "integer"
        },
        "polygons": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array"
          },
          "title": "Polygons",
          "type": "array"
        },
        "evidence": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "reviewer": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date",
          "type": "string"
        }
      },
      "required": [
        "id",
        "image_sha256",
        "class_id",
        "polygons",
        "evidence",
        "reviewer",
        "date"
      ],
      "title": "BackgroundAnchor",
      "type": "object"
    },
    "Disposition": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "pattern": "^(train|valid|test)-[0-9]{3,}$",
          "title": "Left",
          "type": "string"
        },
        "right": {
          "pattern": "^(train|valid|test)-[0-9]{3,}$",
          "title": "Right",
          "type": "string"
        },
        "decision": {
          "enum": [
            "co-group",
            "excluded",
            "unrelated",
            "uncertain"
          ],
          "title": "Decision",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "left",
        "right",
        "decision",
        "rationale"
      ],
      "title": "Disposition",
      "type": "object"
    },
    "Evaluation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "exploratory",
            "independence-reviewed"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "limitations": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "status",
        "evidence",
        "limitations"
      ],
      "title": "Evaluation",
      "type": "object"
    },
    "PartialDecision": {
      "additionalProperties": false,
      "properties": {
        "sample_id": {
          "pattern": "^(train|valid|test)-[0-9]{3,}$",
          "title": "Sample Id",
          "type": "string"
        },
        "source_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "train",
                "validation",
                "test",
                "excluded"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusion Reason"
        },
        "origin": {
          "anyOf": [
            {
              "enum": [
                "human",
                "prediction",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "origin_evidence": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Evidence"
        },
        "eligibility_approved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eligibility Approved"
        },
        "completeness": {
          "anyOf": [
            {
              "enum": [
                "exhaustive",
                "verified-background",
                "non-exhaustive"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completeness"
        },
        "conflict_policy": {
          "default": "reject",
          "enum": [
            "reject",
            "ignore"
          ],
          "title": "Conflict Policy",
          "type": "string"
        },
        "conflict_rationale": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Rationale"
        },
        "group": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "group_status": {
          "anyOf": [
            {
              "enum": [
                "known",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Status"
        },
        "group_evidence": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Evidence"
        },
        "background_anchors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BackgroundAnchor"
          },
          "title": "Background Anchors",
          "type": "array"
        }
      },
      "required": [
        "sample_id",
        "source_path"
      ],
      "title": "PartialDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "reference": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference"
    },
    "reviewer": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "date": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date"
    },
    "mapping": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mapping"
    },
    "class_semantics_approved": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Class Semantics Approved"
    },
    "evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Evaluation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/PartialDecision"
      },
      "title": "Samples",
      "type": "array"
    },
    "dispositions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Disposition"
      },
      "title": "Dispositions",
      "type": "array"
    },
    "supervision_mode": {
      "const": "partial",
      "default": "partial",
      "title": "Supervision Mode",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "source_sha256",
    "samples"
  ],
  "title": "PartialReview",
  "type": "object"
}
