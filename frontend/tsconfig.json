{
  "include": ["src/index.tsx", "src/App.tsx", "src/api.ts"],
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "lib": ["DOM", "ES2020"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true
  }
}
